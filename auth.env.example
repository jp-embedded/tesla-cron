# Copy to .auth.env (ignored by Git), chmod 600 .auth.env, then fill in locally.
# Use a newly rotated secret if an old one has been exposed.
TESLA_CLIENT_ID=''
TESLA_CLIENT_SECRET=''
# Must exactly match an Allowed Redirect URI in your Tesla developer app.
REDIRECT_URI=''
# European Fleet API; override for another region if needed.
AUDIENCE='https://fleet-api.prd.eu.vn.cloud.tesla.com'
