# Optional /etc/tesla-cron/runtime.env, mode 0600; read by tesla-cron-run.
# No OAuth client secret is needed for normal operation.
# TESLA_CLIENT_ID='your-client-id' # overrides config.inc for token refresh
TESLA_SITES_FILE='/etc/tesla-cron/sites.json'
INFLUX_URL='http://localhost:8086'
INFLUX_DB='iot'
TESLA_PROXY_URL='https://127.0.0.1:4443'
TESLA_PROXY_CA_FILE='/usr/local/share/tesla-cron/proxy.crt'
# INFLUX_USER='read-only-user'
# INFLUX_PASS='password'
# Optional separate telemetry writer; otherwise INFLUX_USER/INFLUX_PASS are reused.
# INFLUX_WRITE_USER='telemetry-writer'
# INFLUX_WRITE_PASS='password'
# INFLUX_TIMEOUT_MS=2000 # 1..60000; defaults: queries 10s, writes 2s
